# Options introduced by our patches that do not exist in a vanilla
# Percona Server release, plus upstream options we investigated and
# have specific operational guidance for even though we did not change
# their code or default. Include this file from my.cnf (!include) to
# apply them; every option is listed with its shipped default and the
# loose- prefix so a plain vanilla server still starts if this file is
# used against it.
#
# Each entry:
#   DESCRIPTION: what the option does
#   DEFAULT:     value that applies if left unset (also the value below)
#   RECOMMENDED: guidance if it differs from the default

[mysqld]


# DESCRIPTION: Rewrite replicated SET_USER_ID to
#   SET_ANY_DEFINER,ALLOW_NONEXISTENT_DEFINER in the replica SQL
#   applier, so replicating from an 8.0 source that still grants the
#   removed SET_USER_ID privilege doesn't stop the applier thread.
#   Does not affect user-issued GRANT/REVOKE; can be changed only
#   while the replica SQL thread is stopped.
# DEFAULT: OFF (upstream, opt-in)
# RECOMMENDED: ON -- keeps applier threads from stopping if any 8.0
#   source still replicating to this server grants SET_USER_ID; no
#   effect if none do. Cheaper to leave on than to diagnose an applier
#   stopping mid-upgrade.
loose-replica_translate_deprecated_priv = ON
# DESCRIPTION: Backoff cadence for TTASEventMutex::spin_and_try_lock().
#   1 (default) is the exact upstream behavior: yield and attempt a real
#   sync-array wait on every spin round. N>1 spins purely for longer,
#   then yields, and only falls through to a real sync-array wait every
#   Nth round, trading more CPU spinning for fewer context switches
#   under contention.
# DEFAULT: 1 (upstream-equivalent behaviour)
# RECOMMENDED: 4 -- the value this patchset ships with; trades more CPU
#   spinning for fewer context switches under contention.
loose-innodb_sync_spin_backoff_rounds = 4

# DESCRIPTION: Number of PAUSE instructions used per unit of spin-wait
#   delay (see @@innodb_spin_wait_delay). Upstream MySQL/InnoDB option,
#   not introduced by our patches -- listed here because we
#   investigated it (PAUSE-latency calibration at server startup,
#   MariaDB-MDEV-19845-style) and settled on an operational answer
#   instead of a code change.
# DEFAULT: 50
# RECOMMENDED: 50 (leave at default). Our fleet is uniformly Skylake+
#   or newer, and an independent HammerDB/Intel measurement on
#   Skylake-class hardware found the upstream default already optimal
#   (lowering it to 5 collapsed throughput). A per-host override only
#   becomes relevant if the fleet gains machines older than the
#   ~30-cycles/PAUSE generation boundary (pre-Skylake) -- until then,
#   the uniform default is correct, not a compromise.
loose-innodb_spin_wait_pause_multiplier = 50


# DESCRIPTION: Keep stored procedure and function caches across
#   COM_RESET_CONNECTION and COM_CHANGE_USER (when the authenticated
#   user is unchanged), instead of clearing them unconditionally.
#   Reduces repeated reload-from-data-dictionary work for pooled
#   connections that reissue reset/change-user between calls to the
#   same stored routines.
# DEFAULT: OFF (upstream behaviour: caches cleared unconditionally)
# RECOMMENDED: ON -- the value this patchset ships with; pooled
#   connections reissue reset/change-user between calls to the same
#   routines, and reloading them from the data dictionary each time is
#   pure repeated work. Status counters Sp_cache_insert /
#   Sp_routine_count / Sp_cache_resets_skipped come with this unit.
loose-reset_connection_keep_sp_cache = ON

# DESCRIPTION: Minimum transaction payload size, in bytes, required to
#   apply binary log transaction compression (@@binlog_transaction_
#   compression must also be ON). Transactions smaller than this are
#   written to the binary log uncompressed, skipping compression
#   overhead that rarely pays off at small sizes. Session-scoped
#   (settable per session); the global value sets the default for new
#   sessions.
# DEFAULT: 0 (no threshold -- every eligible transaction is considered
#   for compression, matching pre-existing behavior)
# RECOMMENDED: 0 (leave at default; raise only with a measured
#   workload-specific payload-size distribution showing small
#   transactions dominate compression overhead)
loose-binlog_transaction_compression_min_size = 0

# DESCRIPTION: Maximum threads for parallel buffer pool initialization.
#   0 (default): derive from detected physical CPU cores, capped at
#   innodb_buffer_pool_instances. READONLY (buf_pool_init() reads this
#   exactly once, at startup). Linux only.
# DEFAULT: 0 (auto)
# RECOMMENDED: 0 (leave at default -- auto-derivation from physical
#   core count is the point of this unit; only override for a measured
#   reason on a specific host)
loose-innodb_buffer_pool_parallel_init_threads = 0

# DESCRIPTION: Nice value applied at thread start to the log_writer,
#   log_flusher, log_write_notifier and log_flush_notifier redo log
#   threads. If omitted, preserves the inherited nice value; explicit
#   0 sets nice to 0. READONLY. Effective on Linux only and requires
#   CAP_SYS_NICE (or a sufficient RLIMIT_NICE, e.g. via a systemd
#   drop-in override) to lower the value below the process nice.
# DEFAULT: 0 (when omitted, inherit; when explicitly set, nice 0)
# RECOMMENDED: -15 -- the value this patchset ships with. Requires the
#   systemd drop-in granting CAP_SYS_NICE/RLIMIT_NICE; without it the
#   server logs a warning at startup and keeps the inherited priority.
loose-innodb_log_writer_threads_priority = -15

# DESCRIPTION: Nice value applied at thread start to the
#   log_checkpointer and log_files_governor redo log threads. If omitted,
#   preserves the inherited nice value; explicit 0 sets nice to 0. When
#   both redo priorities are set, warns if this value is not lower than
#   innodb_log_writer_threads_priority. Values are not changed.
#   READONLY. Effective on Linux only, same
#   CAP_SYS_NICE/RLIMIT_NICE requirement as above.
# DEFAULT: 0 (when omitted, inherit; when explicitly set, nice 0)
# RECOMMENDED: -16 -- the value this patchset ships with, one step
#   ahead of innodb_log_writer_threads_priority as recommended above.
loose-innodb_log_writer_threads_checkpoint_priority = -16
