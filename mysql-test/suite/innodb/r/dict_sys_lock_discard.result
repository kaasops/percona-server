CREATE TABLE t1 (id INT PRIMARY KEY, a INT) ENGINE=InnoDB STATS_PERSISTENT=0;
INSERT INTO t1 VALUES (1,1), (2,2), (3,3);
SET GLOBAL innodb_purge_stop_now = ON;
DELETE FROM t1 WHERE id = 1;
ALTER TABLE t1 ALGORITHM=INSTANT, ADD COLUMN b INT DEFAULT 42;
SELECT * FROM t1 ORDER BY id;
id	a	b
2	2	42
3	3	42
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `a` int DEFAULT NULL,
  `b` int DEFAULT '42',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci STATS_PERSISTENT=0
DROP TABLE t1;
