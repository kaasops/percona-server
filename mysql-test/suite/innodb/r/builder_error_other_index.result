# Rows of the clustered index are wide, so its key buffer overflows and
# Builder::insert_direct runs before the secondary index key buffer is
# written to the temporary file for the first time.
CREATE TABLE t1 (id INT PRIMARY KEY, k INT, pad CHAR(200), KEY k (k));
SET SESSION cte_max_recursion_depth = 100000;
INSERT INTO t1
WITH RECURSIVE seq (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq
WHERE n < 100000)
SELECT n, n, REPEAT('a', 200) FROM seq;
SET SESSION cte_max_recursion_depth = DEFAULT;
SELECT COUNT(*) FROM t1;
COUNT(*)
100000
# ddl::pwrite of the secondary index temporary file fails
SET DEBUG = "+d,builder_bulk_add_row_trigger_error_4";
ALTER TABLE t1 ADD COLUMN c2 INT DEFAULT 20, ALGORITHM=INPLACE;
ERROR HY000: Temporary file write failure.
SET DEBUG = "-d,builder_bulk_add_row_trigger_error_4";
# The table is intact after the rollback
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
SELECT COUNT(*) FROM t1;
COUNT(*)
100000
# Pages still buffer fixed should assert during shutdown
# restart
# Cleanup
DROP TABLE t1;
