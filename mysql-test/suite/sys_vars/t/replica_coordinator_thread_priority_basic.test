###############################################################################
# Variable Name: replica_coordinator_thread_priority
# Scope: GLOBAL
# Access Type: Static (read only)
# Data Type: numeric
# Default Value: 0
# Range: -20 - 19
#
# Description: Nice value applied at thread start to this server's
#              replication threads.
###############################################################################

SELECT @@global.replica_coordinator_thread_priority;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@global.replica_coordinator_thread_priority = -15;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@session.replica_coordinator_thread_priority = -15;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET PERSIST replica_coordinator_thread_priority = -15;

SELECT @@global.replica_coordinator_thread_priority;

SELECT VARIABLE_VALUE FROM performance_schema.global_variables
  WHERE VARIABLE_NAME='replica_coordinator_thread_priority';
