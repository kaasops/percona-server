#
# [INT02] Set the scheduling priority of the InnoDB redo log threads
# (innodb_log_writer_threads_priority,
# innodb_log_writer_threads_checkpoint_priority).
#
# Four scenarios, each doing its own restart (assert_grep.inc resets its
# match window on MTR's own "CURRENT_TEST:" marker, not on server
# restarts, so relying on a restart done by an earlier scenario would
# make the match window ambiguous - see mysql-test-run.pl mark_log()):
#  (0) negative control - both options omitted, no
#      "redo log thread priority:" line at all, all six threads keep
#      the nice value inherited from the process;
#  (1) both sysvars set, no correction needed - exactly 4 threads get
#      the writers' nice, exactly 2 get the checkpoint group's;
#  (2) checkpoint priority not strictly above writers' - preserved,
#      one WARNING line plus one SYSTEM line;
#  (3) final restart back to defaults, asserts nothing - see below.
#

--source include/have_perfschema.inc
--source include/linux.inc

--let $error_log = $MYSQLTEST_VARDIR/log/mysqld.1.err
# Non-$-prefixed copy: mysqltest only exports a --let variable to the OS
# environment (and therefore to $ENV{...} in --perl blocks) when its name
# has no leading $ - see client/mysqltest.cc var_set().
--let error_log = $error_log

--let $pid_file_tmp = $MYSQLTEST_VARDIR/tmp/_redo_pid.txt
--let $verify_tmp = $MYSQLTEST_VARDIR/tmp/_redo_verify.txt

--echo #
--echo # Scenario (0): negative control - both priority options are
--echo # omitted, so no "redo log thread priority:" line is
--echo # printed at all, and all six redo log threads keep whatever
--echo # nice value they inherited from the process (compared against
--echo # the observed nice of the main thread, not a hardcoded 0 - MTR
--echo # itself may not start mysqld at nice 0).
--echo #
--let $restart_parameters = restart:
--source include/restart_mysqld.inc

--let $assert_text = scenario (0), step 0: area after this restart contains a completed start
--let $assert_file = $error_log
--let $assert_only_after = starting as process
--let $assert_select = ready for connections\. Version:
# assert_grep.inc requires exactly one of assert_match/assert_count/
# assert_count_condition to be non-empty; mysqltest variables persist
# across --source calls. $assert_count is set explicitly before every
# assert_grep call below. $assert_count_condition is set here and
# cleared at the next assert_grep call below; after that it is never
# touched again and stays empty for the remaining asserts below, since
# none of them need it.
--let $assert_count =
--let $assert_count_condition = >= 1
--source include/assert_grep.inc

--let $assert_text = scenario (0): no redo log thread priority line while both options are omitted
--let $assert_file = $error_log
--let $assert_only_after = starting as process
--let $assert_select = redo log thread priority:
--let $assert_count = 0
--let $assert_count_condition =
--source include/assert_grep.inc

--let $pid_file_path = `SELECT @@GLOBAL.pid_file`
--let pid_file_path = $pid_file_path
--let pid_file_tmp = $pid_file_tmp
--perl
  use strict;
  use warnings;
  open(my $pf, "<", $ENV{pid_file_path})
    or die("Unable to open pid file $ENV{pid_file_path}: $!\n");
  my $pid = <$pf>;
  close($pf);
  chomp($pid);
  $pid =~ s/^\s+|\s+$//g;

  # One /proc path form throughout the test: /proc/<pid>/task/<tid>/stat,
  # field 19 = nice. <pid> is reused here both as the process id and as
  # the id of the "main" (first) thread.
  open(my $sf, "<", "/proc/$pid/task/$pid/stat")
    or die("Unable to open /proc/$pid/task/$pid/stat: $!\n");
  my $line = <$sf>;
  close($sf);
  # comm (field 2) is parenthesized and may itself contain spaces; find
  # the last ')' and split whatever follows it on whitespace instead of
  # trying to regex-match the field boundaries around comm directly.
  my $rparen = rindex($line, ")");
  my @f = split(' ', substr($line, $rparen + 1));
  # f[0] is field 3 (state); field 19 (nice) is f[16].
  my $nice = $f[16];

  open(my $out, ">", $ENV{pid_file_tmp})
    or die("Unable to write $ENV{pid_file_tmp}: $!\n");
  print $out "$pid,$nice";
  close($out);
EOF
--let $_redo_pid_and_nice = `SELECT LOAD_FILE('$pid_file_tmp')`
--remove_file $pid_file_tmp
--let $redo_pid = `SELECT SUBSTRING_INDEX('$_redo_pid_and_nice', ',', 1)`
--let $redo_main_nice = `SELECT SUBSTRING_INDEX('$_redo_pid_and_nice', ',', -1)`

--let $tid_writer = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_writer_thread', THREAD_OS_ID, 1)
--let $tid_flusher = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_flusher_thread', THREAD_OS_ID, 1)
--let $tid_write_notifier = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_write_notifier_thread', THREAD_OS_ID, 1)
--let $tid_flush_notifier = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_flush_notifier_thread', THREAD_OS_ID, 1)
--let $tid_checkpointer = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_checkpointer_thread', THREAD_OS_ID, 1)
--let $tid_files_governor = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_files_governor_thread', THREAD_OS_ID, 1)

--let redo_pid = $redo_pid
--let redo_tids = $tid_writer,$tid_flusher,$tid_write_notifier,$tid_flush_notifier,$tid_checkpointer,$tid_files_governor
--let redo_expected = $redo_main_nice,$redo_main_nice,$redo_main_nice,$redo_main_nice,$redo_main_nice,$redo_main_nice
--let verify_tmp = $verify_tmp
--perl
  use strict;
  use warnings;
  my $pid = $ENV{redo_pid};
  my @tids = split(/,/, $ENV{redo_tids});
  my @expected = split(/,/, $ENV{redo_expected});
  die("tid/expected count mismatch: " . scalar(@tids) . " vs " . scalar(@expected) . "\n")
    unless scalar(@tids) == scalar(@expected);

  my $read_nice = sub {
    my ($tid) = @_;
    open(my $fh, "<", "/proc/$pid/task/$tid/stat")
      or die("Unable to open /proc/$pid/task/$tid/stat: $!\n");
    my $l = <$fh>;
    close($fh);
    my $rp = rindex($l, ")");
    my @f = split(' ', substr($l, $rp + 1));
    return $f[16];
  };

  my @mismatches;
  # Bounded retry (up to 20 x 100ms): the PFS row for a thread can appear
  # before the thread has executed its own first line (where nice is
  # applied) - this closes exactly that startup race, it is not a fixed
  # sleep and does not wait forever.
  for (my $attempt = 0; $attempt < 20; $attempt++) {
    @mismatches = ();
    for (my $i = 0; $i <= $#tids; $i++) {
      my $actual = $read_nice->($tids[$i]);
      push(@mismatches, "tid $tids[$i]: expected $expected[$i], got $actual")
        if ($actual != $expected[$i]);
    }
    last unless @mismatches;
    select(undef, undef, undef, 0.1);
  }

  open(my $out, ">", $ENV{verify_tmp})
    or die("Unable to write $ENV{verify_tmp}: $!\n");
  print $out (@mismatches ? join('; ', @mismatches) : "ok");
  close($out);
EOF
--let $redo_result = `SELECT LOAD_FILE('$verify_tmp')`
--remove_file $verify_tmp
if ($redo_result != 'ok') {
  --echo scenario (0): nice mismatch: $redo_result
  --die scenario (0): nice mismatch
}

--echo #
--echo # Scenario (1): both sysvars set, no correction needed - exactly
--echo # 4 threads (writer, flusher, write_notifier, flush_notifier) get
--echo # the writers' nice, exactly 2 (checkpointer, files_governor) get
--echo # the checkpoint group's. Both values are above the nice observed
--echo # in scenario (0): raising a nice needs no privilege, lowering one
--echo # does, so a test that only raises runs as any user.
--echo #
if (`SELECT $redo_main_nice + 4 > 19`) {
  --skip process nice too high: baseline + 4 exceeds the option range (-20..19)
}
--let $prio_writers = `SELECT $redo_main_nice + 4`
--let $prio_checkpoint = `SELECT $redo_main_nice + 2`
--let $restart_parameters = restart: --innodb-log-writer-threads-priority=$prio_writers --innodb-log-writer-threads-checkpoint-priority=$prio_checkpoint
--let $do_not_echo_parameters = 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters = 0

--let $assert_text = scenario (1): SYSTEM line reports the applied priorities
--let $assert_file = $error_log
--let $assert_only_after = starting as process
--let $assert_select = redo log thread priority: writers nice
--let $assert_count = 1
--source include/assert_grep.inc

--let $pid_file_path = `SELECT @@GLOBAL.pid_file`
--let pid_file_path = $pid_file_path
--perl
  use strict;
  use warnings;
  open(my $pf, "<", $ENV{pid_file_path})
    or die("Unable to open pid file $ENV{pid_file_path}: $!\n");
  my $pid = <$pf>;
  close($pf);
  chomp($pid);
  $pid =~ s/^\s+|\s+$//g;
  open(my $out, ">", $ENV{pid_file_tmp})
    or die("Unable to write $ENV{pid_file_tmp}: $!\n");
  print $out $pid;
  close($out);
EOF
--let $redo_pid = `SELECT LOAD_FILE('$pid_file_tmp')`
--remove_file $pid_file_tmp

# A backtick query, not query_get_value(): the latter splits its
# arguments on every top-level comma, which the IN (...) list here is
# full of.
--let $log_thread_count = `SELECT COUNT(*) FROM performance_schema.threads WHERE NAME IN ('thread/innodb/log_writer_thread', 'thread/innodb/log_flusher_thread', 'thread/innodb/log_write_notifier_thread', 'thread/innodb/log_flush_notifier_thread', 'thread/innodb/log_checkpointer_thread', 'thread/innodb/log_files_governor_thread')`
if ($log_thread_count != 6) {
  --die scenario (1), step 0: expected 6 redo log threads in performance_schema.threads, got $log_thread_count
}

--let $tid_writer = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_writer_thread', THREAD_OS_ID, 1)
--let $tid_flusher = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_flusher_thread', THREAD_OS_ID, 1)
--let $tid_write_notifier = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_write_notifier_thread', THREAD_OS_ID, 1)
--let $tid_flush_notifier = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_flush_notifier_thread', THREAD_OS_ID, 1)
--let $tid_checkpointer = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_checkpointer_thread', THREAD_OS_ID, 1)
--let $tid_files_governor = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_files_governor_thread', THREAD_OS_ID, 1)

--let redo_pid = $redo_pid
--let redo_tids = $tid_writer,$tid_flusher,$tid_write_notifier,$tid_flush_notifier,$tid_checkpointer,$tid_files_governor
--let redo_expected = $prio_writers,$prio_writers,$prio_writers,$prio_writers,$prio_checkpoint,$prio_checkpoint
--perl
  use strict;
  use warnings;
  my $pid = $ENV{redo_pid};
  my @tids = split(/,/, $ENV{redo_tids});
  my @expected = split(/,/, $ENV{redo_expected});
  die("tid/expected count mismatch: " . scalar(@tids) . " vs " . scalar(@expected) . "\n")
    unless scalar(@tids) == scalar(@expected);

  my $read_nice = sub {
    my ($tid) = @_;
    open(my $fh, "<", "/proc/$pid/task/$tid/stat")
      or die("Unable to open /proc/$pid/task/$tid/stat: $!\n");
    my $l = <$fh>;
    close($fh);
    my $rp = rindex($l, ")");
    my @f = split(' ', substr($l, $rp + 1));
    return $f[16];
  };

  my @mismatches;
  for (my $attempt = 0; $attempt < 20; $attempt++) {
    @mismatches = ();
    for (my $i = 0; $i <= $#tids; $i++) {
      my $actual = $read_nice->($tids[$i]);
      push(@mismatches, "tid $tids[$i]: expected $expected[$i], got $actual")
        if ($actual != $expected[$i]);
    }
    last unless @mismatches;
    select(undef, undef, undef, 0.1);
  }

  open(my $out, ">", $ENV{verify_tmp})
    or die("Unable to write $ENV{verify_tmp}: $!\n");
  print $out (@mismatches ? join('; ', @mismatches) : "ok");
  close($out);
EOF
--let $redo_result = `SELECT LOAD_FILE('$verify_tmp')`
--remove_file $verify_tmp
if ($redo_result != 'ok') {
  --echo scenario (1): nice mismatch: $redo_result
  --die scenario (1): nice mismatch
}

--echo #
--echo # Scenario (2): checkpoint priority not strictly above writers' -
--echo # kept as configured, with a WARNING line, plus the
--echo # usual SYSTEM line (two "redo log thread priority:" lines total).
--echo #
call mtr.add_suppression("redo log thread priority");
--let $prio_writers = `SELECT $redo_main_nice + 2`
--let $prio_checkpoint = `SELECT $redo_main_nice + 4`
--let $restart_parameters = restart: --innodb-log-writer-threads-priority=$prio_writers --innodb-log-writer-threads-checkpoint-priority=$prio_checkpoint
--let $do_not_echo_parameters = 1
--source include/restart_mysqld.inc
--let $do_not_echo_parameters = 0

--let $assert_text = scenario (2): WARNING line reports the priority ordering
--let $assert_file = $error_log
--let $assert_only_after = starting as process
--let $assert_select = redo log thread priority: checkpoint group nice $prio_checkpoint is not above
--let $assert_count = 1
--source include/assert_grep.inc

--let $assert_text = scenario (2): exactly one WARNING and one SYSTEM line, no more
--let $assert_file = $error_log
--let $assert_only_after = starting as process
--let $assert_select = redo log thread priority:
--let $assert_count = 2
--source include/assert_grep.inc

--let $ckpt_now = `SELECT @@GLOBAL.innodb_log_writer_threads_checkpoint_priority`
if ($ckpt_now != $prio_checkpoint) {
  --echo scenario (2): checkpoint priority changed to $ckpt_now, expected $prio_checkpoint
  --die scenario (2): checkpoint priority was corrected
}

--let $pid_file_path = `SELECT @@GLOBAL.pid_file`
--let pid_file_path = $pid_file_path
--perl
  use strict;
  use warnings;
  open(my $pf, "<", $ENV{pid_file_path})
    or die("Unable to open pid file $ENV{pid_file_path}: $!\n");
  my $pid = <$pf>;
  close($pf);
  chomp($pid);
  $pid =~ s/^\s+|\s+$//g;
  open(my $out, ">", $ENV{pid_file_tmp})
    or die("Unable to write $ENV{pid_file_tmp}: $!\n");
  print $out $pid;
  close($out);
EOF
--let $redo_pid = `SELECT LOAD_FILE('$pid_file_tmp')`
--remove_file $pid_file_tmp

--let $tid_writer = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_writer_thread', THREAD_OS_ID, 1)
--let $tid_flusher = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_flusher_thread', THREAD_OS_ID, 1)
--let $tid_write_notifier = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_write_notifier_thread', THREAD_OS_ID, 1)
--let $tid_flush_notifier = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_flush_notifier_thread', THREAD_OS_ID, 1)
--let $tid_checkpointer = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_checkpointer_thread', THREAD_OS_ID, 1)
--let $tid_files_governor = query_get_value(SELECT THREAD_OS_ID FROM performance_schema.threads WHERE NAME = 'thread/innodb/log_files_governor_thread', THREAD_OS_ID, 1)

--let redo_pid = $redo_pid
--let redo_tids = $tid_writer,$tid_flusher,$tid_write_notifier,$tid_flush_notifier,$tid_checkpointer,$tid_files_governor
--let redo_expected = $prio_writers,$prio_writers,$prio_writers,$prio_writers,$prio_checkpoint,$prio_checkpoint
--perl
  use strict;
  use warnings;
  my $pid = $ENV{redo_pid};
  my @tids = split(/,/, $ENV{redo_tids});
  my @expected = split(/,/, $ENV{redo_expected});
  die("tid/expected count mismatch: " . scalar(@tids) . " vs " . scalar(@expected) . "\n")
    unless scalar(@tids) == scalar(@expected);

  my $read_nice = sub {
    my ($tid) = @_;
    open(my $fh, "<", "/proc/$pid/task/$tid/stat")
      or die("Unable to open /proc/$pid/task/$tid/stat: $!\n");
    my $l = <$fh>;
    close($fh);
    my $rp = rindex($l, ")");
    my @f = split(' ', substr($l, $rp + 1));
    return $f[16];
  };

  my @mismatches;
  for (my $attempt = 0; $attempt < 20; $attempt++) {
    @mismatches = ();
    for (my $i = 0; $i <= $#tids; $i++) {
      my $actual = $read_nice->($tids[$i]);
      push(@mismatches, "tid $tids[$i]: expected $expected[$i], got $actual")
        if ($actual != $expected[$i]);
    }
    last unless @mismatches;
    select(undef, undef, undef, 0.1);
  }

  open(my $out, ">", $ENV{verify_tmp})
    or die("Unable to write $ENV{verify_tmp}: $!\n");
  print $out (@mismatches ? join('; ', @mismatches) : "ok");
  close($out);
EOF
--let $redo_result = `SELECT LOAD_FILE('$verify_tmp')`
--remove_file $verify_tmp
if ($redo_result != 'ok') {
  --echo scenario (2): nice mismatch: $redo_result
  --die scenario (2): nice mismatch
}

--echo #
--echo # Scenario (3): final restart back to default options - required
--echo # for the mutation gate, which needs the next test in the
--echo # queue to be able to reuse this server: while \$restart_opts is
--echo # left set (a non-default my.cnf line still applied), MTR always
--echo # restarts the next queued test, and check_testcase() also does
--echo # not run for a server with \$restart_opts set. The bare "restart:"
--echo # form (colon, nothing after) clears \$restart_opts entirely - see
--echo # mysql-test-run.pl's parsing of the .expect file. Nothing is
--echo # asserted here on purpose.
--echo #
--let $restart_parameters = restart:
--source include/restart_mysqld.inc
