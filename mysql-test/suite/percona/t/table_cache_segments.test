#
# [D-39]/C2 step 2: Table_cache_manager::init() now allocates each
# Table_cache instance as its own page-aligned segment through the
# ut_malloc_page_withkey()/ut_free_page() bridge
# (storage/innobase/include/ut0page_alloc.h) instead of embedding it in a
# statically sized array. This test checks the PFS-visible consequences of
# that at the server's own startup: read-only, no server restart.
#

--echo #
--echo # Step 0: the PFS memory key for table cache segments is registered
--echo # exactly once. Guards every query below against a silent 0 from a
--echo # typo'd instrument name - a typo here would otherwise make every
--echo # subsequent assertion vacuously true instead of failing loudly.
--echo #
SELECT COUNT(*) AS segment_key_registered_once
  FROM performance_schema.setup_instruments
 WHERE NAME = 'memory/sql/Table_cache::segment';

--echo #
--echo # PFS memory accounting for the segment key: one allocation per
--echo # resolved table cache instance, total bytes an exact multiple of the
--echo # instance count (each segment maps the same size), nothing freed
--echo # (segments live for the server's lifetime). No hardcoded page size or
--echo # byte count here - a host with a different getconf PAGE_SIZE must not
--echo # make this test fail silently or need updating.
--echo #
SELECT COUNT_ALLOC = @@GLOBAL.table_open_cache_instances
         AS count_alloc_matches_instances,
       SUM_NUMBER_OF_BYTES_ALLOC % COUNT_ALLOC = 0
         AS bytes_alloc_is_multiple_of_count,
       COUNT_FREE = 0 AS nothing_freed
  FROM performance_schema.memory_summary_global_by_event_name
 WHERE EVENT_NAME = 'memory/sql/Table_cache::segment';

--echo #
--echo # [DEC-24]: the unconditional startup line (ER_TABLE_CACHE_SEGMENTS,
--echo # MY-048207) was logged at this server's own startup.
--echo #
SELECT COUNT(*) >= 1 AS segments_startup_line_logged
  FROM performance_schema.error_log
 WHERE error_code = 'MY-048207';
